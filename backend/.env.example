# Copy this file to .env and adjust values for local development.
# Never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=urban_reports
DB_USERNAME=urban_reports
DB_PASSWORD=local_development_only

BACKEND_PORT=8080

# Cloudflare R2 (use credentials restricted to a private development bucket).
IMAGE_STORAGE_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_BUCKET=urban-reports-development
IMAGE_STORAGE_ACCESS_KEY=replace_with_local_access_key
IMAGE_STORAGE_SECRET_KEY=replace_with_local_secret_key
