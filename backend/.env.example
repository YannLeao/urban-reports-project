# Copy this file to .env and adjust values for local development.
# Never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=urban_reports
DB_USERNAME=urban_reports
DB_PASSWORD=local_development_only
# Optional: uncomment to override DB_HOST, DB_PORT and DB_NAME.
# DB_URL=jdbc:postgresql://example-host/urban_reports?sslmode=require

# Documentation is disabled by default. Opt in only for local development:
# Imported from backend/.env when running with backend/ as the working directory.
# Restart the backend after changing the profile.
# SPRING_PROFILES_ACTIVE=dev
# On Render, explicitly configure SPRING_PROFILES_ACTIVE=prod.
BACKEND_PORT=8080
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare R2 (use credentials restricted to a private development bucket).
IMAGE_STORAGE_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_BUCKET=urban-reports-development
IMAGE_STORAGE_ACCESS_KEY=replace_with_local_access_key
IMAGE_STORAGE_SECRET_KEY=replace_with_local_secret_key

# Required RSA keys: generate outside the checkout; see docs/security.md.
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=urban-reports-api
AUTH_JWT_KEY_ID=local-v1
AUTH_JWT_PRIVATE_KEY_FILE=/absolute/path/outside/repository/private.pem
AUTH_JWT_PUBLIC_KEY_FILE=/absolute/path/outside/repository/public.pem

# Recuperação durável de novos uploads; atraso >= PT2M, lote 1-100.
IMAGE_RECOVERY_ENABLED=true
IMAGE_RECOVERY_INTERVAL=60000
IMAGE_RECOVERY_SAFETY_DELAY=PT5M
IMAGE_RECOVERY_BATCH_SIZE=20

# Administrative invitations: canonical frontend origin, no trailing slash.
ADMIN_FRONTEND_ORIGIN=http://localhost:5173
# Notification capture remains active when consumption is disabled. No legacy backfill.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_FRONTEND_ORIGIN=http://localhost:5173
# Poll 1000-3600000 ms; batch 1-20; lease <=3600000 and >= request deadline +30000 ms.
NOTIFICATIONS_EMAIL_POLL_INTERVAL_MS=60000
NOTIFICATIONS_EMAIL_BATCH_SIZE=3
NOTIFICATIONS_EMAIL_LEASE_MS=60000
# Backend-only REST API key (not an SMTP key); leave blank to disable sending.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME="Alô Cidade"
EMAIL_CONNECT_TIMEOUT_MS=3000
EMAIL_REQUEST_TIMEOUT_MS=10000

# Optional local diagnostics: this file is imported as properties, not process env.
# logging.level.com.project.software.urbanreports.email.observability=DEBUG
# logging.structured.format.console=logstash
# Restore WARN after capture; never enable HTTP wire/header/body logging.

# Photos: fixed multipart limits are 5242880 bytes/file and 27262976 bytes/request.
# No new R2 credentials/bucket needed for multiple photos; see docs/multiple-photos.md.
